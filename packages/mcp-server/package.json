{
  "name": "@ombrix/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP 2.0) server with Code Mode for OMBRIX steganography & visual forensics suite",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "ombrix-mcp": "./dist/index.js"
  },
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "mcp2",
    "code-mode",
    "model-context-protocol",
    "steganography",
    "forensics",
    "ai-agents"
  ],
  "scripts": {
    "build": "node ../../scripts/build-tools.mjs mcp",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ombrix/crypto-adapter": "workspace:*",
    "@ombrix/edge-sdk": "workspace:*",
    "@ombrix/image-validation": "workspace:*",
    "@ombrix/stego-advanced": "workspace:*",
    "@ombrix/stego-forensics": "workspace:*",
    "@ombrix/stego-interface": "workspace:*",
    "@ombrix/stego-lab": "workspace:*",
    "@ombrix/stego-png-lsb": "workspace:*"
  }
}
