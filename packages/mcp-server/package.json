{
  "name": "@ombrix/mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol (MCP) server for OMBRIX — Steganography & Visual Cryptanalysis Suite for AI Agents",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "bin": {
    "ombrix-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node ../../scripts/build-tools.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ombrix/crypto-adapter": "workspace:*",
    "@ombrix/edge-sdk": "workspace:*",
    "@ombrix/image-validation": "workspace:*",
    "@ombrix/stego-advanced": "workspace:*",
    "@ombrix/stego-forensics": "workspace:*",
    "@ombrix/stego-interface": "workspace:*",
    "@ombrix/stego-lab": "workspace:*",
    "@ombrix/stego-png-lsb": "workspace:*"
  }
}
