{
  "name": "@ombrix/edge-sdk",
  "version": "0.1.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src", "README.md"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@ombrix/image-validation": "workspace:*",
    "@ombrix/payload-protocol": "workspace:*",
    "@ombrix/stego-interface": "workspace:*",
    "@ombrix/stego-png-lsb": "workspace:*",
    "@ombrix/crypto-adapter": "workspace:*",
    "@ombrix/carrier-lens": "workspace:*",
    "@ombrix/stego-lab": "workspace:*",
    "@ombrix/transit-trace": "workspace:*",
    "@ombrix/link-sharing": "workspace:*",
    "@ombrix/batch-pipeline": "workspace:*",
    "@ombrix/stego-advanced": "workspace:*",
    "@ombrix/stego-forensics": "workspace:*"
  },
  "scripts": {
    "build": "node ../../scripts/build-tools.mjs edge-sdk",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  }
}
