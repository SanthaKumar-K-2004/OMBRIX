{
  "name": "@ombrix/cli",
  "version": "0.1.0",
  "description": "Zero-telemetry forensic steganography CLI and MCP 2.0 Code Mode runner",
  "type": "module",
  "bin": {
    "ombrix": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "files": ["dist", "README.md"],
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["steganography", "forensics", "mcp", "code-mode", "security", "cryptography", "cli"],
  "scripts": {
    "build": "node ../../scripts/build-tools.mjs cli",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ombrix/crypto-adapter": "workspace:*",
    "@ombrix/edge-sdk": "workspace:*",
    "@ombrix/image-validation": "workspace:*",
    "@ombrix/mcp-server": "workspace:*",
    "@ombrix/stego-advanced": "workspace:*",
    "@ombrix/stego-forensics": "workspace:*",
    "@ombrix/stego-interface": "workspace:*",
    "@ombrix/stego-lab": "workspace:*",
    "@ombrix/stego-png-lsb": "workspace:*"
  }
}
