{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "strictBindCallApply": true,
    "strictPropertyInitialization": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@ombrix/image-validation": ["packages/image-validation/src/index.ts"],
      "@ombrix/payload-protocol": ["packages/payload-protocol/src/index.ts"],
      "@ombrix/stego-interface": ["packages/stego-interface/src/index.ts"],
      "@ombrix/stego-png-lsb": ["packages/stego-png-lsb/src/index.ts"],
      "@ombrix/stego-worker": ["packages/stego-worker/src/index.ts"],
      "@ombrix/crypto-adapter": ["packages/crypto-adapter/src/index.ts"]
    }
  }
}
