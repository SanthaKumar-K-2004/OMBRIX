{
  "name": "ombrix-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "pnpm --filter @ombrix/web run dev",
    "preview": "pnpm --filter @ombrix/web run preview",
    "build": "pnpm -r run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "pnpm -r run typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "release:package": "node --experimental-strip-types scripts/release-package.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
